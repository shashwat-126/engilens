# Copy to .env before running `docker compose up`.

# Required -- docker-compose refuses to start the backend without this set
# (see the ${JWT_SECRET:?...} guard in docker-compose.yml). Generate one with:
#   openssl rand -base64 32
JWT_SECRET=

# Optional -- change the default local Postgres password
POSTGRES_PASSWORD=

# Optional -- set whichever LLM provider(s) you want live generation from.
# None set = the app falls back to the offline extractive Mock provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
GEMINI_API_KEY=
